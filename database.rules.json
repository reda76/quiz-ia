          "$tour": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('mots/' + $code + '/joueurs/' + $uid).exists() && root.child('mots/' + $code + '/etat/phase').val() === 'saisie' && root.child('mots/' + $code + '/etat/cle').val() === $tour",
              ".validate": "newData.hasChildren(['mot', 't']) && newData.child('mot').isString() && newData.child('mot').val().length >= 1 && newData.child('mot').val().length <= 24 && newData.child('t').val() === now"
            }
          }
        },
        "presents": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('mots/' + $code + '/joueurs/' + $uid).exists()",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "groupes": {
