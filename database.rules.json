        "hote": {
          ".read": "auth != null"
        },
        "creeLe": {
          ".read": "auth != null"
        },
        "etat": {
          ".read": "auth != null"
        },
        "joueurs": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('groupes/' + $code + '/hote').exists()",
            ".validate": "newData.hasChildren(['prenom', 'rejointLe']) && newData.child('prenom').isString() && newData.child('prenom').val().length >= 1 && newData.child('prenom').val().length <= 20 && newData.child('rejointLe').val() === now"
          }
        },
        "points": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('groupes/' + $code + '/joueurs/' + $uid).exists() && root.child('groupes/' + $code + '/etat/phase').val() === 'placement'",
            ".validate": "newData.hasChildren(['x', 'y']) && newData.child('x').isNumber() && newData.child('y').isNumber() && newData.child('x').val() >= 0 && newData.child('x').val() <= 200 && newData.child('y').val() >= 0 && newData.child('y').val() <= 200"
          }
        },
        "resultat": {
          ".read": "auth != null"
        },
        "presents": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('groupes/' + $code + '/joueurs/' + $uid).exists()",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "salles": {
      "$code": {
        ".validate": "$code.matches(/^[0-9]{6}$/)",
        ".write": "auth != null && (!data.exists() || data.child('hote').val() === auth.uid)",
        "hote": {
          ".read": "auth != null"
        },
        "creeLe": {
          ".read": "auth != null"
        },
        "jeu": {
          ".read": "auth != null"
        },
        "joueurs": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('salles/' + $code + '/hote').exists()",
            ".validate": "newData.hasChildren(['prenom', 'rejointLe']) && newData.child('prenom').isString() && newData.child('prenom').val().length >= 1 && newData.child('prenom').val().length <= 20 && newData.child('rejointLe').val() === now"
          }
